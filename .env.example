# ============================================================
#  NORA — Chatbot ENCG Marrakech | Variables d'Environnement
# ============================================================
# Copiez ce fichier en .env et remplissez vos valeurs

# --- Réseau Local Wi-Fi ---
# Adresse IP de votre PC sur le Wi-Fi (obtenue avec 'ipconfig' sur Windows)
HOST_IP=192.168.0.182
# URL dynamique de l'API Flask utilisée par le frontend ou d'autres applications sur le même Wi-Fi :
VITE_API_URL=http://192.168.0.182:5000
# Autorise les connexions depuis n'importe quel smartphone/PC du réseau Wi-Fi :
CORS_ORIGINS=*

# --- PostgreSQL ---
POSTGRES_DB=nora_db
POSTGRES_USER=nora_user
POSTGRES_PASSWORD=nora_secret_password

# --- Backend Flask ---
DB_HOST=db
DB_PORT=5432
DB_NAME=nora_db
DB_USER=nora_user
DB_PASSWORD=nora_secret_password
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key

# --- IA Provider ---
# Obtenez une clé gratuite sur https://aistudio.google.com/
AI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
