# ============================================================
#  NORA — Chatbot ENCG Marrakech | Variables d'Environnement
# ============================================================
# Copiez ce fichier en .env et remplissez vos valeurs

# --- PostgreSQL ---
POSTGRES_DB=nora_db
POSTGRES_USER=nora_user
POSTGRES_PASSWORD=nora_secret_password

# --- Backend Flask ---
DB_HOST=db
DB_PORT=5432
DB_NAME=nora_db
DB_USER=nora_user
DB_PASSWORD=nora_secret_password
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key

# --- IA Provider ---
# Obtenez une clé gratuite sur https://aistudio.google.com/
AI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
