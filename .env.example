# ============================================================
#  NORA — Chatbot ENCG Marrakech | Variables d'Environnement
# ============================================================
# Copiez ce fichier en .env et remplissez vos valeurs.
# En production : ce contenu doit être mis dans la variable
# ENV_FILE_CONTENT dans GitLab > Settings > CI/CD > Variables.

# --- PostgreSQL ---
POSTGRES_DB=nora_db
POSTGRES_USER=nora_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Backend Flask (public) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=nora_db
DB_USER=nora_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
FLASK_ENV=production
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_64_CHARS

# --- IA Provider (Google Gemini) ---
# Obtenez une clé gratuite sur https://aistudio.google.com/
AI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite

# --- CORS (production) ---
# En prod avec reverse-proxy nginx, le frontend est sur le même
# domaine que l'API — pas besoin de CORS ouvert.
# Si vous accédez à l'API depuis d'autres domaines, listez-les ici.
CORS_ORIGINS=*

# --- Frontend Public (Vite build arg) ---
# En production avec reverse-proxy nginx, laisser VIDE.
# Nginx proxy /api/* → backend:5000 automatiquement.
VITE_API_URL=

# --- Back-Office Admin (backend_admin, port 5001) ---
SECRET_KEY_ADMIN=CHANGE_ME_ANOTHER_RANDOM_SECRET
# Compte admin initial (inséré en BDD par init.sql)
ADMIN_EMAIL=admin@encg.ac.ma
ADMIN_PASSWORD=CHANGE_ME_MIN_8_CHARS
# CORS admin : en prod avec nginx, le frontend_admin est sur le même domaine
CORS_ORIGINS_ADMIN=http://localhost:8080
EMBEDDING_MODEL=models/text-embedding-004
