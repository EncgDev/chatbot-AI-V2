# ──────────────────────────────────────────────────────────
#  NORA Admin — Frontend Production (Vite + React → Nginx)
#  Multi-stage build identique au frontend public
# ──────────────────────────────────────────────────────────

# ─── STAGE 1 : Build React avec Node.js ──────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Variable d'env pour Vite (injecté au build time)
ARG VITE_ADMIN_API_URL=http://localhost:5001
ENV VITE_ADMIN_API_URL=$VITE_ADMIN_API_URL

# Dépendances en premier (cache Docker)
COPY package.json package-lock.json* ./
RUN npm ci --prefer-offline

# Code source
COPY . .

# Build de production
RUN npm run build

# ─── STAGE 2 : Servir avec Nginx ─────────────────────────
FROM nginx:1.25-alpine AS runner

# Config Nginx custom (SPA support + reverse proxy backend_admin)
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

# Fichiers statiques buildés
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s \
  CMD wget -q --spider http://localhost:8080 || exit 1

CMD ["nginx", "-g", "daemon off;"]
